# =============================================================================
# PROMPTS.CHAT - Docker Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (External PostgreSQL - Required)
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://prompts_user:your_password@postgres-host:5432/prompts_db?schema=public

# Direct URL for migrations (optional, defaults to DATABASE_URL)
# Use this if you have a connection pooler (Neon, Supabase, PlanetScale)
# DIRECT_URL=postgresql://prompts_user:your_password@postgres-host:5432/prompts_db?schema=public

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_THIS_TO_RANDOM_SECRET

# -----------------------------------------------------------------------------
# BRANDING
# -----------------------------------------------------------------------------
BRAND_NAME=My Prompt Library
BRAND_DESCRIPTION=Collect, organize, and share AI prompts
BRAND_LOGO=/logo.svg
BRAND_LOGO_DARK=/logo.svg
BRAND_FAVICON=/logo.svg
BRAND_COLOR=#6366f1

# -----------------------------------------------------------------------------
# THEME
# -----------------------------------------------------------------------------
THEME_RADIUS=sm          # Options: none, sm, md, lg
THEME_VARIANT=default    # Options: default, flat, brutal
THEME_DENSITY=default    # Options: compact, default, comfortable

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Comma-separated list: credentials,github,google,azure
AUTH_PROVIDERS=credentials
ALLOW_REGISTRATION=true

# OAuth Providers (optional)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_AZURE_AD_CLIENT_ID=
# AUTH_AZURE_AD_CLIENT_SECRET=
# AUTH_AZURE_AD_TENANT_ID=

# -----------------------------------------------------------------------------
# INTERNATIONALIZATION
# -----------------------------------------------------------------------------
# Comma-separated locales: en,es,fr,de,ja,zh,ar,pt,tr,ko,it
LOCALES=en
DEFAULT_LOCALE=en

# -----------------------------------------------------------------------------
# FEATURES
# -----------------------------------------------------------------------------
FEATURE_PRIVATE_PROMPTS=true
FEATURE_CHANGE_REQUESTS=true
FEATURE_CATEGORIES=true
FEATURE_TAGS=true
FEATURE_COMMENTS=true
FEATURE_AI_SEARCH=false
FEATURE_AI_GENERATION=false
FEATURE_MCP=false

# -----------------------------------------------------------------------------
# AI FEATURES (Optional)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_GENERATIVE_MODEL=gpt-4o-mini
# OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# STORAGE (Optional)
# -----------------------------------------------------------------------------
# Options: url (default), s3, do-spaces
ENABLED_STORAGE=url

# S3 / S3-Compatible Storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=  # For MinIO, DigitalOcean Spaces, etc.

# DigitalOcean Spaces
# DO_SPACES_BUCKET=
# DO_SPACES_REGION=
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_CDN_ENDPOINT=

# -----------------------------------------------------------------------------
# MONITORING & LOGGING (Optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=info  # Options: trace, debug, info, warn, error, fatal

# GOOGLE_ANALYTICS_ID=G-XXXXXXXXX
# SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# CRON JOBS (Optional)
# -----------------------------------------------------------------------------
# CRON_SECRET=your-secret-key-here

# -----------------------------------------------------------------------------
# ADVANCED (Optional)
# -----------------------------------------------------------------------------
# ENHANCED_AUTH_PROTECTION=true
# DEBUG_MIDDLEWARE=false
